model": "social.comment", "pk": 4, "fields": {"post": 3, "author": 1, "content": "Necesitamos digitalizar nuestra facturación.", "timestamp": "2026-09-01T20:45:38.128Z", "updated_at": "2026-09-01T20:45:38.128Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 5, "fields": {"post": 3, "author": 2, "content": "Excelente servicio, muy recomendados.", "timestamp": "2026-09-01T20:45:38.135Z", "updated_at": "2026-09-01T20:45:38.135Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 6, "fields": {"post": 4, "author": 6, "content": "¿Tienen café pergamino para el mercado local?", "timestamp": "2026-09-01T20:45:38.141Z", "updated_at": "2026-09-01T20:45:38.141Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 7, "fields": {"post": 4, "author": 1, "content": "¿Aceptan pedidos por taza? Me encanta el café de altura.", "timestamp": "2026-09-01T20:45:38.149Z", "updated_at": "2026-09-01T20:45:38.149Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 8, "fields": {"post": 5, "author": 2, "content": "Hermosa fusión de tradición y modernidad.", "timestamp": "2026-09-01T20:45:38.155Z", "updated_at": "2026-09-01T20:45:38.155Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 9, "fields": {"post": 7, "author": 3, "content": "¿Cuándo es la exposición? Nos encantaría asistir.", "timestamp": "2026-09-01T20:45:38.162Z", "updated_at": "2026-09-01T20:45:38.162Z", "upvotes": 0, "downvotes": 0}}, {"model": "social.comment", "pk": 10, "fields": {"post": 8, "author": 3, "content": "Estamos interesados en el diagnóstico gratuito.", "timestamp": "2026-09-01T20:45:38.168Z", "updated_at": "2026-09-01T20:45:38.168Z", "upvotes": 0, "downvotes": 0}}, {"model": "messaging.message", "pk": 1, "fields": {"sender": 1, "recipient": 3, "content": "Hola, vi que ofrecen digitalización de facturación. ¿Qué incluye?", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.341Z", "read_by": [3]}}, {"model": "messaging.message", "pk": 2, "fields": {"sender": 3, "recipient": 1, "content": "Buenas, sí. Incluye sistema de facturación, capacitación y soporte por 3 meses.", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.356Z", "read_by": [3]}}, {"model": "messaging.message", "pk": 3, "fields": {"sender": 1, "recipient": 3, "content": "¿Cuál sería el precio para una panadería pequeña?", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.369Z", "read_by": [3]}}, {"model": "messaging.message", "pk": 4, "fields": {"sender": 3, "recipient": 1, "content": "Tenemos un plan inicial desde $300. Podemos agendar una demo gratis.", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.383Z", "read_by": [3]}}, {"model": "messaging.message", "pk": 5, "fields": {"sender": 2, "recipient": 4, "content": "Hola! Nos interesa un café de especialidad para regalar a clientes.", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.405Z", "read_by": [4]}}, {"model": "messaging.message", "pk": 6, "fields": {"sender": 4, "recipient": 2, "content": "¡Hola! Tenemos tueste medio y oscuro. ¿Cuántas libras necesitan?", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.420Z", "read_by": [4]}}, {"model": "messaging.message", "pk": 7, "fields": {"sender": 2, "recipient": 4, "content": "Aproximadamente 20 libras mensuales.", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.435Z", "read_by": [4]}}, {"model": "messaging.message", "pk": 8, "fields": {"sender": 4, "recipient": 2, "content": "Perfecto, les doy precio por volumen y envío a Estelí incluido.", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.448Z", "read_by": [4]}}, {"model": "messaging.message", "pk": 9, "fields": {"sender": 6, "recipient": 1, "content": "Hola, tenemos queso y lácteos frescos. ¿Les interesa para sus productos?", "image": "", "video": "", "timestamp": "2026-09-01T20:45:38.472Z", "read_by": [1]}}, {"model": "messaging.message", "pk": 10, "fields": {"sender": 1, "recipient": 6, "con